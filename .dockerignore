# ============================================================
# Docker Ignore - Optimized for Build Performance
# ============================================================
# Exclude files not needed in Docker images to:
# - Reduce build context size
# - Speed up image builds
# - Minimize final image size

# ============================================================
# Version Control
# ============================================================
.git/
.gitignore
.gitattributes
.gitmodules
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.circleci/

# ============================================================
# Documentation (exclude from build)
# ============================================================
*.md
!README.md
docs/
.docs/
LICENSE
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md

# Temporary summary docs
PHASE-*-COMPLETE.md
WEEK-*-COMPLETION-SUMMARY.md
*-SUMMARY.md
QUICKSTART-PHASE-*.md
TEST-VALIDATION-COMPLETE.md

# ============================================================
# IDE & Editor Files
# ============================================================
.vscode/
.idea/
.atom/
.sublime-project
.sublime-workspace
*.code-workspace
*.swp
*.swo
*~
.editorconfig

# ============================================================
# Dependencies (will be installed in container)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak
.npm/
.yarn/cache/
.pnp.*

# ============================================================
# Build Artifacts (will be built in container)
# ============================================================
dist/
build/
out/
.next/
*.tsbuildinfo
coverage/
.nyc_output/

# Service-specific builds
gatekeeper/dist/
gatekeeper/build/
flag-oracle/dist/
flag-oracle/build/
realms/*/dist/
realms/*/build/

# ============================================================
# Testing (exclude from production)
# ============================================================
tests/
test/
__tests__/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
test-results/
playwright-report/
.playwright/
playwright/.auth/
coverage/
.nyc_output/
jest.config.*
playwright.config.*

# Service-specific tests
gatekeeper/tests/
flag-oracle/tests/
realms/*/tests/

# ============================================================
# Environment Files
# ============================================================
.env
.env.*
!.env.example
*.env.local
*.env.bak
.env.development
.env.test
.env.production

# ============================================================
# Logs & Runtime Data
# ============================================================
logs/
*.log
log/
test-logs/
gatekeeper/logs/
gatekeeper/test-logs/
flag-oracle/logs/
flag-oracle/test-logs/
attack-traces/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
loki_data/
prometheus_data/
grafana_data/

# ============================================================
# OS Generated Files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*

# ============================================================
# Docker Files (don't copy into container)
# ============================================================
.dockerignore
Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose*.yml
.docker-data/
.docker/

# ============================================================
# CI/CD Specific
# ============================================================
.github/
.circleci/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
Jenkinsfile
.drone.yml

# ============================================================
# Development Tools
# ============================================================
Makefile
.editorconfig
.prettierrc
.prettierignore
.eslintrc*
.eslintignore
tsconfig.json
!tsconfig.json
jsconfig.json

# ============================================================
# Security & Scanning
# ============================================================
.gitleaks.toml
.gitleaks-report.json
scan-secrets-report.json
.snyk
security-scan-*.json

# ============================================================
# Python (for scanner scripts - exclude from Node images)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv/
*.egg-info/
.ipynb_checkpoints/
.python-version
pip-log.txt

# ============================================================
# Temporary Files
# ============================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old
*-old
*.orig
*.swp
*.swo

# ============================================================
# Project Specific
# ============================================================
# User data (generated at runtime)
progress_data/
user-data/
cookies.txt
sessions/
uploads/

# Scanner results (generated at runtime)
scanner-results/
nuclei-output/
zap-reports/

# Secrets (should never be in images)
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.pfx

# Database files
*.sqlite
*.sqlite3
*.db
dump.rdb
appendonly.aof

# ============================================================
# Scripts (typically not needed in container)
# ============================================================
scripts/
!scripts/entrypoint.sh
!scripts/docker-*.sh

# ============================================================
# Optional: Service-Specific Excludes
# ============================================================
# Uncomment when building a specific service

# When building gatekeeper only:
# flag-oracle/
# realms/

# When building flag-oracle only:
# gatekeeper/
# realms/

# When building a realm only:
# gatekeeper/
# flag-oracle/
# realms/*/
# !realms/_shared/
# !realms/REALM_NAME/

# ============================================================
# Keep Important Files
# ============================================================
# Use ! to negate patterns if needed
!package.json
!package-lock.json
!.npmrc.docker
!tsconfig.prod.json
