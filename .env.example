# Application Configuration
APP_PORT=8080
NODE_ENV=development

# Attack Trace Logging (for AI training and security research)
ATTACK_TRACE_ENABLED=true
ATTACK_TRACE_PATH=./logs/attack-traces
ATTACK_TRACE_FORMAT=openai

# Flag Oracle Configuration
FLAG_ORACLE_URL=http://flag-oracle:3001
FLAG_ORACLE_PORT=3001
DATA_PATH=/data

# Redis Configuration (optional, falls back to file-based storage)
REDIS_URL=redis://redis:6379

# Rate Limiting Configuration (Flag Oracle)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Session Configuration (Gatekeeper)
# Generate with: openssl rand -hex 32
SESSION_SECRET=<generate-strong-secret-for-production>
SESSION_MAX_AGE_MS=3600000

# Auth Rate Limiting (Gatekeeper)
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# CORS Configuration (Gatekeeper - optional)
# Set to specific origin for production (e.g., https://yggdrasil.example.com)
# Empty string or * allows all origins (use * only for development)
ALLOWED_ORIGIN=

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# Test User Configuration (Gatekeeper)
TEST_USER_PASSWORD=yggdrasil123

# ---------------------------------------------------------------------------
# FLAGS — generated per deployment, never committed
# ---------------------------------------------------------------------------
# `make setup` fills in every *_FLAG below and FLAG_MASTER_SECRET with fresh
# random values, and `scripts/generate-flags.sh` can be re-run at any time to
# fill gaps (or `--force` to rotate everything).
#
# Leave them empty here. Realms refuse to start without an explicitly configured
# FLAG, and the Flag Oracle builds its valid-flag set from these same variables,
# so an unconfigured realm simply cannot be captured — it never falls back to a
# value that exists in the repository.
#
# FLAG_MASTER_SECRET keys the per-user HMAC flags. Back it up: losing it
# invalidates every flag the Oracle has ever issued.
FLAG_MASTER_SECRET=

# Discord Webhook (optional, for community event broadcasts)
# Leave empty to disable. When set, successful flag captures, first-bloods, and full
# platform completions are broadcast to this Discord channel webhook.
DISCORD_WEBHOOK_URL=

# Sample Realm Configuration
# The warm-up realm is unscored, so its flag is deliberately a fixed, public
# placeholder rather than a generated secret.
SAMPLE_REALM_FLAG=YGGDRASIL{SAMPLE:00000000-0000-0000-0000-000000000000}

# Realms 10-8 Configuration
NIFLHEIM_FLAG=
HELHEIM_FLAG=
SVARTALFHEIM_FLAG=

# Realms 7-5 Configuration
JOTUNHEIM_FLAG=
JOTUNHEIM_SESSION_SECRET=<generate-strong-secret-for-production>
MUSPELHEIM_FLAG=
# Also seeded into the Postgres database at container init.
NIDAVELLIR_FLAG=
NIDAVELLIR_DB_PASSWORD=<generate-strong-password-for-production>

# Realms 4-1 Configuration
VANAHEIM_FLAG=
MIDGARD_FLAG=
ALFHEIM_FLAG=
# Also seeded into the Postgres database at container init.
ASGARD_FLAG=
ASGARD_DB_PASSWORD=<generate-strong-password-for-production>

# Observability Stack Configuration
# Opt-in. Leave false for fast local startup: when false, gatekeeper/flag-oracle
# never load prom-client or winston-loki. Set true and launch the observability
# stack (docker compose -f docker-compose.yml -f docker-compose.observability.yml up)
# to ship metrics to Prometheus and logs to Loki.
OBSERVABILITY_ENABLED=false
LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generate-strong-password-for-production>
